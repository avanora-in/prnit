# Google Tag Manager (public — safe to expose to the browser)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Gmail SMTP — server only; never commit real values (use App Password if 2FA is on).
EMAIL_USER=
EMAIL_PASS=

# Inbox that receives contact form submissions (server-only).
CONTACT_TO_EMAIL=

# Contact API abuse limits (server-side). Optional — defaults shown in lib/contact/rate-limit.ts comments.
# Trust X-Forwarded-For / CF-Connecting-IP for client IP (set true behind nginx/HAProxy you control).
# On Vercel, forwarded headers are trusted automatically (VERCEL=1). Use false to ignore spoofable headers.
# CONTACT_TRUST_PROXY=true
# Masked logs for rate-limit / honeypot events (see CONTACT_LOG_CONTACT_EVENTS).
# CONTACT_LOG_CONTACT_EVENTS=true
# Max POST attempts per IP per rolling 1-second window (then HTTP 429). Default 3.
# CONTACT_MAX_ATTEMPTS_PER_SECOND=3
# Instant temporary block if this many attempts land in one second (burst).
# CONTACT_BURST_BLOCK_THRESHOLD=15
# Sliding window for counting repeated rate-limit hits before a longer block.
# CONTACT_VIOLATIONS_WINDOW_MS=600000
# How many rate-limit violations in that window trigger a 20–25 minute style block.
# CONTACT_VIOLATIONS_FOR_BLOCK=5
# Block duration bounds (ms). Pickup is random between min and max per block event.
# CONTACT_BLOCK_MIN_MS=1200000
# CONTACT_BLOCK_MAX_MS=1500000
